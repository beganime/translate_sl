DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=translate.manager-sl.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://translate.manager-sl.ru
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
DATA_ENCRYPTION_SECRET=replace-with-a-second-long-random-value
WORD_PDF_CONVERSION=0
SQLITE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media
# Production can use PostgreSQL instead of SQLITE_PATH. Keep each service in
# its own schema when sharing one managed PostgreSQL cluster.
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require&options=-csearch_path%3Dtranslate_sl
# DB_CONN_MAX_AGE=60
