    {
      "path": "body.p[5]",
      "text": "Данный паспорт является собственностью Туркменистана.",
      "alignment": "CENTER (1)",
      "style": "Normal",
      "runs": [
        {
          "text": "Данный паспорт является собственностью Туркменистана.",
